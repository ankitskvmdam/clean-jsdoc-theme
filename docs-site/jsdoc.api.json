{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["./src", "./README.md"]
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "encoding": "utf8",
    "basePath": "/clean-jsdoc-theme/api-docs",
    "destination": "dist/clean-jsdoc-theme/api-docs",
    "recurse": true,
    "template": "./node_modules/clean-jsdoc-theme/dist",
    "readme": "./README.md",
    "siteName": {
      "light": "./assets/clean-jsdoc-theme.svg",
      "dark": "./assets/clean-jsdoc-theme-white.svg",
      "alt": "clean-jsdoc-theme API"
    },
    "clubSidebarItems": true,
    "menu": [
      {
        "title": "Home",
        "link": "/",
        "id": "api-docs",
        "icon": "lucide:home"
      },
      {
        "title": "Home ",
        "link": "https://ankdev.me/clean-jsdoc-theme",
        "id": "home",
        "icon": "lucide:website"
      },
      {
        "title": "Github",
        "link": "https://github.com/ankitskvmdam/clean-jsdoc-theme",
        "id": "github",
        "icon": "simpleicons:github"
      }
    ]
  }
}
