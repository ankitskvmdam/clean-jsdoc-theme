{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["./empty.js", "./README.md"]
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "encoding": "utf8",
    "basePath": "/clean-jsdoc-theme",
    "destination": "dist/clean-jsdoc-theme",
    "recurse": true,
    "template": "./node_modules/clean-jsdoc-theme/dist",
    "readme": "./README.md",
    "docs": "./docs",
    "docGroups": ["Packages", "Using the Theme", "Guides", "Authoring"],
    "defaultDocGroup": "Docs",
    "sectionOrder": ["Using the Theme", "Guides", "Authoring", "Packages"],
    "siteName": {
      "light": "./assets/clean-jsdoc-theme.svg",
      "dark": "./assets/clean-jsdoc-theme-white.svg",
      "alt": "clean-jsdoc-theme"
    },
    "clubSidebarItems": true,
    "menu": [
      {
        "title": "Home",
        "link": "/",
        "id": "home",
        "icon": "lucide:home"
      },
      {
        "title": "API Example Page",
        "link": "/clean-jsdoc-theme/api-docs/",
        "id": "api-docs",
        "icon": "lucide:website"
      },
      {
        "title": "Github",
        "link": "https://github.com/ankitskvmdam/clean-jsdoc-theme",
        "id": "github",
        "icon": "simpleicons:github"
      }
    ]
  }
}
