{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["./empty.js", "./README.md"]
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "encoding": "utf8",
    "basePath": "/clean-jsdoc-theme",
    "siteUrl": "https://ankdev.me/clean-jsdoc-theme/",
    "destination": "dist/clean-jsdoc-theme",
    "recurse": true,
    "template": "./node_modules/clean-jsdoc-theme/dist",
    "readme": "./README.md",
    "favicon": "./assets/logo-small.svg",
    "docs": "./docs",
    "docGroups": ["Packages", "Using the Theme", "Guides", "Components"],
    "defaultDocGroup": "Docs",
    "sectionOrder": ["Using the Theme", "Guides", "Components", "Packages"],
    "locales": [
      { "code": "en", "name": "English" },
      { "code": "hi", "name": "हिन्दी" },
      { "code": "ja", "name": "日本語" },
      { "code": "zh", "name": "中文" }
    ],
    "defaultLocale": "en",
    "siteName": {
      "light": "./assets/clean-jsdoc-theme.svg",
      "dark": "./assets/clean-jsdoc-theme-white.svg",
      "alt": "clean-jsdoc-theme"
    },
    "clubSidebarItems": true,
    "menu": [
      {
        "title": "Home",
        "link": "/",
        "id": "home",
        "icon": "lucide:home"
      },
      {
        "title": "JSDoc API Example",
        "link": "/clean-jsdoc-theme/api-docs/",
        "id": "api-docs",
        "icon": "lucide:website"
      },
      {
        "title": "TypeDoc API Example",
        "link": "/clean-jsdoc-theme/typedoc-api-docs/",
        "id": "typedoc-api-docs",
        "icon": "lucide:website"
      },
      {
        "title": "v4 Docs",
        "link": "/clean-jsdoc-theme/v4/",
        "id": "v4-docs",
        "icon": "lucide:history"
      },
      {
        "title": "npm",
        "link": "https://www.npmjs.com/package/clean-jsdoc-theme",
        "id": "npm",
        "icon": "simpleicons:npm"
      },
      {
        "title": "Github",
        "link": "https://github.com/ankitskvmdam/clean-jsdoc-theme",
        "id": "github",
        "icon": "simpleicons:github"
      }
    ]
  }
}
