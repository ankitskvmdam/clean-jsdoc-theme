{
  "watch": [
    "src",
    "docs",
    "README.md",
    "jsdoc.json",
    "jsdoc.api.json",
    "../packages/clean-jsdoc-theme/dist",
    "../packages/dwar/dist",
    "../packages/rang/dist",
    "../packages/setu/dist",
    "../packages/utils/dist"
  ],
  "ext": "js,cjs,mjs,json,md,markdown,html",
  "delay": 400,
  "exec": "jsdoc -c jsdoc.json && jsdoc -c jsdoc.api.json"
}
