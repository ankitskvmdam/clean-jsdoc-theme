{
  "tags": {
    "allowUnknownTags": true
  },
  "source": {
    "include": ["./src", "./README.md"]
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "encoding": "utf8",
    "destination": "dist",
    "recurse": true,
    "template": "./node_modules/clean-jsdoc-theme/dist",
    "readme": "./README.md",
    "tutorials": "./tutorials",
    "siteName": "clean-jsdoc-theme"
  }
}
