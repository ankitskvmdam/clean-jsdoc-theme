{
  "name": "example-basic",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:theme": "pnpm exec turbo run build --filter=clean-jsdoc-theme",
    "build:docs": "jsdoc -c jsdoc.json",
    "docs": "pnpm run build:theme && jsdoc -c jsdoc.json",
    "dev": "pnpm run build:theme && concurrently -k -n pkgs,site \"pnpm exec turbo watch build --filter=clean-jsdoc-theme\" \"vite\"",
    "clean-node-modules": "node ../../scripts/clean.mjs node_modules",
    "serve": "vite"
  },
  "devDependencies": {
    "clean-jsdoc-theme": "workspace:^",
    "concurrently": "^9.0.0",
    "jsdoc": "^4.0.0",
    "vite": "^8.1.3"
  }
}
