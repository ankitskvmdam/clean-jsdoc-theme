{
  "name": "example-with-i18n",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:theme": "pnpm exec turbo run build --filter=clean-jsdoc-theme --filter=@clean-jsdoc-theme/aadesh",
    "extract": "clean-jsdoc i18n extract",
    "build:docs": "clean-jsdoc build",
    "docs": "pnpm run build:theme && clean-jsdoc build",
    "serve": "vite",
    "clean-node-modules": "node ../../scripts/clean.mjs node_modules",
    "i18n:extract": "clean-jsdoc i18n extract",
    "dev": "pnpm run build:theme && concurrently -k -n pkgs,site \"pnpm exec turbo watch build --filter=clean-jsdoc-theme --filter=@clean-jsdoc-theme/aadesh\" \"vite\""
  },
  "devDependencies": {
    "@clean-jsdoc-theme/aadesh": "workspace:^",
    "clean-jsdoc-theme": "workspace:^",
    "concurrently": "^9.0.0",
    "jsdoc": "^4.0.0",
    "vite": "^8.1.3"
  }
}
