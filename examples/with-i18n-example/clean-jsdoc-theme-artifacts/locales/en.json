  "api": {
    "module:widget-kit#description": "<p>A tiny, fully-documented sample module that exists to demonstrate\n<code>clean-jsdoc-theme</code>'s <strong>multi-language</strong> documentation support.</p>\n<p>clean-jsdoc-theme renders this API reference in several languages from a\nsingle source. Class and method descriptions, parameter docs, and example\ncaptions are translated per locale, while the UI chrome — search, the\nsidebar, the table of contents, and settings — is localized too. Use the\nglobe control beside the title to switch languages; every page links to its\ncounterpart in each configured language, and anything not yet translated\ngracefully falls back to the default language.</p>",
    "module:widget-kit#summary": "<p>A documented sample module showcasing localized API docs.</p>",
    "module:widget-kit.Widget#constructor.description": "<p>Create a widget.</p>",
    "module:widget-kit.Widget#description": "<p>A reusable UI widget — the running example for this documentation site.</p>\n<p>This class shows how each documented member (the constructor, fields, and\nmethods) renders its own section, and how their prose is translated for every\nconfigured locale while the code stays the same.</p>",
    "module:widget-kit.Widget#disabled#description": "<p>Whether the widget is currently disabled.</p>",
    "module:widget-kit.Widget#examples.0.caption": "Create and render a widget",
    "module:widget-kit.Widget#id#description": "<p>The widget's unique identifier.</p>",
    "module:widget-kit.Widget#label#description": "<p>The visible label, or the id when none was given.</p>",
    "module:widget-kit.Widget#render#description": "<p>Render the widget to a detached DOM element.</p>",
    "module:widget-kit.Widget#setDisabled#description": "<p>Enable or disable the widget.</p>",
    "module:widget-kit.createWidget#description": "<p>Create a widget from a plain configuration object — a small convenience\nwrapper over the {@link Widget} constructor.</p>"
  },
