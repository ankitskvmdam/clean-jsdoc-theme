{
  "name": "clean-jsdoc-theme",
  "version": "5.0.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitskvmdam/clean-jsdoc-theme.git"
  },
  "author": "Ankit Kumar (hello@ankdev.me)",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "build:docs": "turbo run build:docs",
    "build:all": "turbo run build build:docs",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "check:docs": "node scripts/check-docs.mjs",
    "clean": "pnpm -r --parallel run clean && node scripts/clean.mjs node_modules",
    "clean-node-modules": "pnpm -r --parallel run clean-node-modules && node scripts/clean.mjs node_modules",
    "changeset": "changeset",
    "release:check": "changeset status --verbose",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build && changeset publish"
  },
  "homepage": "https://ankdev.me/clean-jsdoc-theme/v4/index.html",
  "keywords": [
    "jsdoc",
    "template",
    "jsdoc-template",
    "jsdoc to markdown",
    "javascript documentation",
    "customizable jsdoc theme / template",
    "llm docs"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.13.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "tsup": "^8.5.1",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  }
}
