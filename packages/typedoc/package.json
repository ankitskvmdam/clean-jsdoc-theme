{
  "name": "@clean-jsdoc-theme/typedoc",
  "version": "5.2.1",
  "description": "A modern TypeDoc theme with dark mode, built-in search, i18n, and LLM-ready Markdown for every page. Part of clean-jsdoc-theme.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "typedoc",
    "typedoc-theme",
    "typedoc-plugin",
    "typedocplugin",
    "typescript",
    "documentation",
    "documentation-generator",
    "generator",
    "api-documentation",
    "api-docs",
    "dark-mode",
    "search",
    "i18n",
    "llm",
    "clean-jsdoc-theme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitskvmdam/clean-jsdoc-theme.git"
  },
  "author": "Ankit Kumar (hello@ankdev.me)",
  "homepage": "https://ankdev.me/clean-jsdoc-theme/theme/typedoc-getting-started",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ankitskvmdam"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs dist .turbo",
    "clean-node-modules": "node ../../scripts/clean.mjs node_modules"
  },
  "dependencies": {
    "@clean-jsdoc-theme/utils": "workspace:^",
    "@clean-jsdoc-theme/setu": "workspace:^",
    "@clean-jsdoc-theme/dwar": "workspace:^",
    "@jsdoc/salty": "^0.2.12",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.0",
    "micromark-extension-gfm": "^3.0.0",
    "preact": "^10.22.0"
  },
  "peerDependencies": {
    "typedoc": "^0.28.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
