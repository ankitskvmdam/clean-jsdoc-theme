{
  "name": "@clean-jsdoc-theme/aadesh",
  "version": "5.0.0-alpha.2",
  "description": "CLI for clean-jsdoc-theme i18n and build workflows",
  "type": "module",
  "bin": {
    "clean-jsdoc": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs dist .turbo",
    "clean-node-modules": "node ../../scripts/clean.mjs node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitskvmdam/clean-jsdoc-theme.git"
  },
  "author": "Ankit Kumar (hello@ankdev.me)",
  "license": "MIT",
  "dependencies": {
    "@clean-jsdoc-theme/setu": "workspace:^",
    "@clean-jsdoc-theme/bhasha": "workspace:^",
    "commander": "14.0.3",
    "ora": "9.3.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
