{
  "name": "clean-jsdoc-theme",
  "version": "5.0.2",
  "description": "A modern, markdown-first JSDoc theme with i18n support",
  "main": "./dist/publish.js",
  "types": "./dist/publish.d.ts",
  "exports": {
    ".": {
      "require": "./dist/publish.js",
      "types": "./dist/publish.d.ts",
      "import": "./dist/publish.mjs"
    },
    "./publish": {
      "require": "./dist/publish.js",
      "types": "./dist/publish.d.ts",
      "import": "./dist/publish.mjs"
    }
  },
  "files": [
    "publish.js",
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitskvmdam/clean-jsdoc-theme.git"
  },
  "author": "Ankit Kumar (hello@ankdev.me)",
  "homepage": "https://ankdev.me/clean-jsdoc-theme/theme/jsdoc-getting-started",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs dist .turbo",
    "clean-node-modules": "node ../../scripts/clean.mjs node_modules"
  },
  "peerDependencies": {
    "jsdoc": ">=4.x"
  },
  "dependencies": {
    "@clean-jsdoc-theme/bhasha": "workspace:^",
    "@clean-jsdoc-theme/dwar": "workspace:^",
    "@clean-jsdoc-theme/rang": "workspace:^",
    "@clean-jsdoc-theme/setu": "workspace:^",
    "@clean-jsdoc-theme/utils": "workspace:^",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "jsdoc",
    "jsdoc-template",
    "jsdoc-theme",
    "documentation"
  ]
}
